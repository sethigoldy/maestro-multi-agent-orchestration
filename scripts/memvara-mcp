#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PYTHON="$ROOT/.venv/bin/python"
[[ -x "$PYTHON" ]] || PYTHON="$(command -v python3)"
export MEMVARA_DB="$ROOT/.maestro/memory.db"
export MEMVARA_USER="${MEMVARA_USER:-developer}"
export MEMVARA_TENANT="${MEMVARA_TENANT:-default}"
export MEMVARA_PREDICATES="engineering,decisions"
exec "$PYTHON" -m memvara.server
