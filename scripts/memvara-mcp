#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PYTHON="$ROOT/.venv/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  PYTHON="$(command -v python3 || true)"
fi
if [[ -z "$PYTHON" ]]; then
  echo "maestro: no Python interpreter found; expected $ROOT/.venv/bin/python or python3 on PATH" >&2
  exit 127
fi
export MEMVARA_DB="$ROOT/.maestro/memory.db"
export MEMVARA_USER="${MEMVARA_USER:-developer}"
export MEMVARA_TENANT="${MEMVARA_TENANT:-default}"
export MEMVARA_PREDICATES="engineering,decisions"
exec "$PYTHON" -m memvara.server
